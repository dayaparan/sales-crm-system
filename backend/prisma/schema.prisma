generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Branch model representing organizational branches
model Branch {
  id String @id @default(uuid()) @map("id")

  // Relations
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("UserCreatedBranches", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Many-to-many relation for managers
  managers User[] @relation("BranchManagers")

  // Relation for users associated with this branch
  users User[] @relation("UserToBranch")

  territories  Territory[]   @relation("BranchToTerritory")
  leads        Lead[]        @relation("BranchToLeads")
  paymentPlans PaymentPlan[] @relation("PaymentPlanToBranch")
  // projects     Project[]     @relation("ProjectToBranch")
  salesModels  SalesModel[]  @relation("SalesModelToBranch")
  unitTypes    UnitType[]    @relation("UnitTypeToBranch")

  // Basic Info
  name     String @map("name")
  code     String @map("code")
  country  String @map("country")
  city     String @map("city")
  address  String @map("address")
  timezone String @map("timezone")
  currency String @map("currency")

  // Contact
  phone String @map("phone")
  email String @map("email")

  // Status & Timestamps
  status        Boolean         @default(true) @map("status")
  deletedAt     DateTime?       @map("deleted_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  BranchManager BranchManager[]

  @@index([createdById])
  @@index([status])
  @@map("branches")
}

// Explicit relation table for many-to-many relationship between Branch and User (managers)
model BranchManager {
  branchId String @map("branch_id")
  userId   String @map("user_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([branchId, userId])
  @@map("branch_managers")
}

// PaymentPlan model representing payment plans for projects
model PaymentPlan {
  id                 String    @id @default(uuid()) @map("id")
  userId             String?   @map("user_id")
  user               User?     @relation("PaymentPlanToUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branchId           String?   @map("branch_id")
  branch             Branch?   @relation("PaymentPlanToBranch", fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name               String    @map("name")
  modelType          String?   @map("modelType")
  duration           String?   @map("duration")
  downPayment        String?   @map("downPayment")
  installment        String?   @map("installment")
  discountPercentage String?   @map("discountPercentage")
  guaranteedRoi      String?   @map("guaranteedRoi")
  specialCondition   String?   @map("specialCondition")
  status             Boolean   @default(true) @map("status")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  leads              Lead[]    @relation("PaymentPlanToLeads")

  @@index([userId])
  @@index([status])
  @@map("payment_plans")
}

// SalesModel model representing sales models or strategies
model SalesModel {
  // Unique identifier for the sales model
  id String @id @default(uuid()) @map("id")

  // Associated user (optional)
  userId String? @map("user_id")
  user   User?   @relation("SalesModelToUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  branchId String? @map("branch_id")
  branch   Branch? @relation("SalesModelToBranch", fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  name                 String        @map("name") // Required sales model name
  ownershipType        OwnershipType @map("ownership_type") // Type of ownership (e.g., FULL, FRACTIONAL)
  minInvestmentLakhs   Float?        @map("min_investment_lakhs") // Minimum investment in lakhs (Indian currency)
  buybackTerms         String?       @map("buyback_terms") // Terms for buyback agreement
  usageRights          UsageRights   @map("usage_rights") // Rights associated with usage (e.g., EXCLUSIVE, SHARED)
  guaranteedRoiPercent Float?        @map("guaranteed_roi_percent") // Guaranteed return on investment percentage
  profitSharePercent   Float?        @map("profit_share_percent") // Profit share percentage
  status               Boolean       @default(true) @map("status") // Active/inactive sales model
  deletedAt            DateTime?     @map("deleted_at") // Soft delete support
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  leads Lead[] @relation("SalesModelToLeads")

  // Indexes for common queries
  @@index([userId])
  @@index([status])
  @@index([ownershipType])
  @@map("sales_models")
}

// Enum for ownership type in SalesModel
enum OwnershipType {
  FULL
  FRACTIONAL
  LEASE
  TIMESHARE
}

// Enum for usage rights in SalesModel
enum UsageRights {
  EXCLUSIVE
  SHARED
  LIMITED
}

// Territory model representing sales territories
model Territory {
  id        String    @id @default(uuid()) @map("id")
  userId    String?   @map("user_id")
  user      User?     @relation("TerritoryToUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branchId  String?   @map("branch_id")
  branch    Branch?   @relation("BranchToTerritory", fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name      String    @map("name") // Required territory name
  status    Boolean   @default(true) @map("status")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  leads     Lead[]    @relation("TerritoryToLeads")

  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@map("territories")
}

